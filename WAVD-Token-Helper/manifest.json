{
  "manifest_version": 3,
  "name": "WAVD Suno Token Helper",
  "description": "Copies the current Suno session token for use in WAVD Desktop.",
  "version": "1.0.0",
  "minimum_chrome_version": "95",
  "permissions": [
    "activeTab",
    "scripting",
    "clipboardWrite"
  ],
  "icons": {
    "16": "assets/alien-mascot.png",
    "32": "assets/alien-mascot.png",
    "48": "assets/alien-mascot.png",
    "128": "assets/alien-mascot.png"
  },
  "action": {
    "default_title": "Copy Suno token",
    "default_icon": "assets/alien-mascot.png",
    "default_popup": "popup.html"
  }
}
